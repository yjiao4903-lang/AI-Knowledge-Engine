{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "taskpack-result-v1",
  "title": "TaskPack Result V1 (SynthesisDraftV1)",
  "description": "外部 Worker 唯一机器输出（V3.0 方案 §13）。evidence_refs 必须逐字使用 evidence.jsonl 中的 chunk_id（§16）；membership、coverage 与 stale 校验由 Research OS Importer Gate（§46-§48）独立执行。",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "query",
    "claims",
    "tensions",
    "uncertainties",
    "open_questions",
    "additional_evidence_needed",
    "worker",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "task_type": {
      "enum": [
        "summary",
        "comparison",
        "causal_synthesis",
        "tension_extraction"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "epistemic_state",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "如 claim_001"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "epistemic_state": {
            "enum": [
              "supported",
              "inference",
              "hypothesis",
              "uncertain",
              "contradicted"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "必须逐字复制 evidence.jsonl 中的 chunk_id"
          },
          "rationale": {
            "type": "string",
            "description": "简短可验证依据（可选，非 Chain-of-Thought）"
          }
        },
        "additionalProperties": true
      }
    },
    "tensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "如 tension_001"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "additional_evidence_needed": {
      "type": "array",
      "description": "证据不足时的显式缺口声明（§17）：禁止用包外知识补洞",
      "items": {
        "type": "object",
        "required": [
          "question",
          "reason"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "worker": {
      "type": "object",
      "description": "生成工具溯源，模型无关（§51）：不预设任何 provider/model",
      "required": [
        "tool"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
